{
  "name": "guitar-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @guitar/web",
    "dev:api": "npm run dev -w @guitar/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "npm run build --workspaces --if-present",
    "migrate": "tsx apps/api/src/migrate.ts",
    "test:browser": "playwright test",
    "seed:demo": "tsx apps/api/src/seed-demo.ts",
    "design:tokens": "node scripts/design-system.mjs --write",
    "design:check": "node scripts/design-system.mjs"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "globals": "17.4.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
